{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.6.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "volta": {
    "node": "22.23.5"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:node": "npx -y is-my-node-vulnerable",
    "audit:lockfile": "pnpm install --frozen-lockfile --lockfile-only --ignore-scripts",
    "audit:secrets": "gitleaks git --redact --verbose",
    "audit:secrets:staged": "gitleaks git --pre-commit --staged --redact --verbose",
    "audit:sast": "semgrep scan --config p/nextjs --config p/react --config p/javascript --config p/nodejsscan --metrics=off --error",
    "validate": "pnpm run audit:lockfile && pnpm run audit:node && pnpm run audit:prod && pnpm run build"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.1",
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^1.6.6",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.10.4",
    "lenis": "^1.3.4",
    "lucide-react": "^0.525.0",
    "negotiator": "^1.0.0",
    "next": "15.5.29",
    "next-themes": "^0.2.0",
    "parse-numeric-range": "^1.3.0",
    "postcss": "^8.5.33",
    "react": "^18.2.0",
    "react-datepicker": "^4.8.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.3",
    "react-syntax-highlighter": "^15.5.0",
    "react-textarea-autosize": "^8.3.4",
    "remark": "^14.0.2",
    "remark-html": "^15.0.1",
    "styled-components": "^5.3.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.0.24",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.12",
    "sharp": "^0.35.5",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "js-yaml@<3.15.2": "^3.15.2",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7",
      "sharp@<0.35.5": "^0.35.5",
      "postcss@<8.5.18": "^8.5.33"
    }
  }
}
